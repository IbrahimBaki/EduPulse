      "typeVersion": 2,
      "position": [240, 580],
      "webhookId": "edupulse-exam-score-alert"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('⚙️ Config').item.json.APP_URL }}/api/v1/{{ $('⚙️ Config').item.json.TENANT_CODE }}/webhooks/n8n/notify",
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"secret\": \"{{ $('⚙️ Config').item.json.N8N_INCOMING_SECRET }}\",\n  \"type\": \"exam_score_alert\",\n  \"user_ids\": [{{ $('exam_score_alert').item.json.student_id }}],\n  \"title\": \"Low Exam Score Alert\",\n  \"body\": \"Hello {{ $('exam_score_alert').item.json.student_name }}, you scored {{ $('exam_score_alert').item.json.percentage }}% on the exam \\\"{{ $('exam_score_alert').item.json.exam_title }}\\\" in {{ $('exam_score_alert').item.json.course_name }}. Please review the material and reach out to your teacher.\",\n  \"data\": {\n    \"exam_title\": \"{{ $('exam_score_alert').item.json.exam_title }}\",\n    \"course_name\": \"{{ $('exam_score_alert').item.json.course_name }}\",\n    \"score\": {{ $('exam_score_alert').item.json.score }},\n    \"percentage\": {{ $('exam_score_alert').item.json.percentage }}\n  }\n}",
        "options": {}
      },
      "id": "04-notify-exam-score-alert",
      "name": "Notify: Low Exam Score",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 580]
    }
