      "name": "score_alert",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 440],
      "webhookId": "edupulse-score-alert"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('⚙️ Config').item.json.APP_URL }}/api/v1/{{ $('⚙️ Config').item.json.TENANT_CODE }}/webhooks/n8n/notify",
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"secret\": \"{{ $('⚙️ Config').item.json.N8N_INCOMING_SECRET }}\",\n  \"type\": \"score_alert\",\n  \"user_ids\": [{{ $('score_alert').item.json.student_id }}],\n  \"title\": \"Low Quiz Score Alert\",\n  \"body\": \"Hello {{ $('score_alert').item.json.student_name }}, you scored {{ $('score_alert').item.json.score }}% on the quiz about \\\"{{ $('score_alert').item.json.topic }}\\\". Consider reviewing this topic again.\",\n  \"data\": {\n    \"topic\": \"{{ $('score_alert').item.json.topic }}\",\n    \"score\": {{ $('score_alert').item.json.score }},\n    \"lesson_id\": {{ $('score_alert').item.json.lesson_id }}\n  }\n}",
        "options": {}
      },
      "id": "04-notify-score-alert",
      "name": "Notify: Low Quiz Score",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 440]
    },

    {
      "parameters": {
        "path": "exam_score_alert",
