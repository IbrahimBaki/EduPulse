        "body": "={\n  \"secret\": \"{{ $('⚙️ Config').item.json.N8N_INCOMING_SECRET }}\",\n  \"type\": \"student_welcome\",\n  \"user_ids\": [{{ $('student_registered').item.json.student_id }}],\n  \"title\": \"Welcome to EduPulse!\",\n  \"body\": \"Hello {{ $('student_registered').item.json.name }}, your student account has been created. Your student code is {{ $('student_registered').item.json.student_code }}.\",\n  \"data\": { \"student_code\": \"{{ $('student_registered').item.json.student_code }}\" }\n}",
